ANTHROPIC_API_KEY=sk-ant-...
# ingestion converts the course PDFs to Markdown with Mistral OCR
MISTRAL_API_KEY=
IKN_MODEL_LARGE=claude-sonnet-5
IKN_MODEL_SMALL=claude-haiku-4-5

# owner of the files the backend writes to ./data
IKN_UID=1000
IKN_GID=1000

# development setup: backend reloads on changes, Vite on :5173
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# add the user "mock": a sample course whose chats get sample replies instead of calling the Anthropic API
# IKN_MOCK_USER=1
