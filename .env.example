ANTHROPIC_API_KEY=sk-ant-...
IKN_MODEL_LARGE=claude-opus-5
IKN_MODEL_SMALL=claude-sonnet-5

# owner of the files the backend writes to ./data
IKN_UID=1000
IKN_GID=1000

# development setup: backend reloads on changes, Vite on :5173
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# answer chats with sample replies instead of calling the Anthropic API
# IKN_MOCK_AI=1
