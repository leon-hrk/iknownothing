@startuml
skinparam shadowing false
skinparam defaultTextAlignment center

participant "Frontend" as frontend
participant "Tutor\n(Backend)" as tutor
participant "Course Store" as store
participant "AI Client" as ai

frontend -> tutor : POST transcript\n(another chat opened or tab closed)
tutor --> frontend : 202 Accepted

group background task
  tutor -> store : read topic.md, progress.md
  tutor -> ai : transcript, topic, progress
  ai --> tutor : updated progress
  tutor -> store : write progress.md
end
@enduml
