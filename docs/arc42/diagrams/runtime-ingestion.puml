@startuml
skinparam shadowing false
skinparam defaultTextAlignment center

actor "Student" as student
participant "Frontend" as frontend
participant "Courses" as courses
participant "Ingestion\n(Worker)" as ingestion
participant "Course Store" as store
participant "AI Client" as ai

student -> frontend : create course,\nupload PDFs and notes.md
frontend -> courses : upload
courses -> store : sources/<type>/<file>.pdf,\nnotes.md
student -> frontend : start ingestion
frontend -> courses : start
courses -> ingestion : enqueue job
activate ingestion

ingestion -> ai : all PDFs, notes.md
ai --> ingestion : language, topics with sources
ingestion -> store : ingestion/topics.json
ingestion -> courses : language

ingestion -> store : topics/<topic>/topic.md,\ntopics.json
ingestion -> courses : ready
deactivate ingestion

loop while ingesting
  frontend -> courses : poll status
end
@enduml
