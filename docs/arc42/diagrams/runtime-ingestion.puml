@startuml
skinparam shadowing false
skinparam defaultTextAlignment center

actor "Student" as student
participant "Frontend" as frontend
participant "Courses\n(HTTP API)" as courses
participant "Ingestion" as ingestion
participant "Course Store" as store
participant "AI Client" as ai
participant "OCR Client" as ocr

student -> frontend : New course: name, notes, PDFs
frontend -> courses : POST /api/courses
courses -> store : sources/<type>/<file>.pdf,\nnotes.md
courses -> ingestion : start in the background
activate ingestion
courses --> frontend : 202 Accepted

loop every PDF without Markdown
  ingestion -> ocr : PDF
  ocr --> ingestion : Markdown, figures
  ingestion -> store : sources/<type>/<file>/*,\nsources/<type>/<file>.md
end

loop every past exam not read yet
  ingestion -> ai : its conversions without figures,\nnotes.md, topics so far
  ai --> ingestion : new and changed topics,\nsources
  ingestion -> store : ingestion/topics.json
end

par every exercise sheet not read yet
  ingestion -> ai : its conversions without figures,\ntopics
  ai --> ingestion : sources assigned to topics\nor other-tasks
end
ingestion -> store : ingestion/topics.json

opt the topics or the tasks grouping may move changed
  ingestion -> ai : tasks of other-tasks and of\nexam-less topics, topics
  ai --> ingestion : new topics, tasks that move
  ingestion -> store : ingestion/topics.json
end

ingestion -> store : topics/<topic>/topic.md,\ntopics.json

par every topic whose tasks changed since its solutions
  ingestion -> ai : its tasks with figures,\ntopic.md, language
  ai --> ingestion : reference solutions for\nthe tasks without one
  ingestion -> store : topics/<topic>/solutions.md
end
ingestion -> store : ingestion/topics.json
deactivate ingestion

loop while the ingestion runs
  frontend -> courses : GET /api/courses
  courses --> frontend : the step it is at
end
@enduml
