@startuml
skinparam shadowing false
skinparam defaultTextAlignment center

actor "Operator" as operator
participant "Courses\n(command)" as courses
participant "Ingestion" as ingestion
participant "Course Store" as store
participant "AI Client" as ai

operator -> courses : course add <user> <course> [<dir>]
courses -> store : sources/<type>/<file>.pdf,\nnotes.md
courses -> ingestion : ingest
activate ingestion

ingestion -> ai : all PDFs, notes.md
ai --> ingestion : language, topics with sources
ingestion -> store : ingestion/topics.json

ingestion -> store : topics/<topic>/topic.md,\ntopics.json
deactivate ingestion
courses --> operator : steps, token usage
@enduml
