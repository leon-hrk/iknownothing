@startuml
skinparam shadowing false
skinparam defaultTextAlignment center

actor "Student" as student
actor "Operator" as operator
cloud "Anthropic API" as ai

node "Host (docker-compose)" {
  node "backend\n(application image)" as backend
  folder "data/" as fs
  folder "courses/\n(read-only)" as courses
}

student --> backend : HTTP (localhost)
operator --> backend : docker compose exec
backend --> fs
backend --> courses
backend --> ai
@enduml
