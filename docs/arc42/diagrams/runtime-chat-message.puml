@startuml
skinparam shadowing false
skinparam defaultTextAlignment center

participant "Frontend" as frontend
participant "Tutor" as tutor
participant "Course Store" as store
participant "AI Client" as ai

frontend -> tutor : POST topic, transcript, message
tutor -> store : read the topic's context\n(tasks with figures)
tutor -> ai : context, transcript, chat tools

loop until the reply has no tool call
  ai --> tutor : streamed reply
  tutor --> frontend : SSE text
  opt tool call
    tutor -> store : execute tool
    tutor --> frontend : SSE tool event
    opt step completed
      tutor -> store : write progress.json,\nread context again
    end
    tutor -> ai : tool result\n(messages since the last step)
  end
end

tutor -> store : write chat.json
tutor --> frontend : SSE end
frontend -> frontend : append reply to transcript
@enduml
